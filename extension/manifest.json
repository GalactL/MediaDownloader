{
  "manifest_version": 2,
  "name": "MediaDownloader",
  "version": "0.4.0",
  "description": "Télécharge la vidéo de la page avec MediaDownloader (yt-dlp et FFmpeg).",
  "browser_specific_settings": {
    "gecko": {
      "id": "mediadownloader@localhost",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["nativeMessaging", "storage"],
  "browser_action": {
    "default_title": "MediaDownloader",
    "default_icon": "icons/icon.svg",
    "theme_icons": [{ "light": "icons/icon-light.svg", "dark": "icons/icon-dark.svg", "size": 16 }, { "light": "icons/icon-light.svg", "dark": "icons/icon-dark.svg", "size": 32 }]
  },
  "icons": { "48": "icons/icon.svg", "96": "icons/icon.svg" },
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://youtu.be/*"],
      "js": ["lib.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": ["content.css"]
}
