{
  "manifest_version": 3,
  "name": "MediaDownloader",
  "version": "0.6.0",
  "description": "Télécharge la vidéo de la page avec MediaDownloader (yt-dlp et FFmpeg).",
  "key": "",
  "permissions": ["nativeMessaging", "storage"],
  "action": {
    "default_title": "MediaDownloader",
    "default_icon": { "16": "icons/icon-16.png", "48": "icons/icon-48.png" }
  },
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://youtu.be/*", "*://x.com/*", "*://www.x.com/*", "*://twitter.com/*", "*://www.twitter.com/*", "*://www.tiktok.com/*", "*://www.instagram.com/*"],
      "js": ["shim.js", "i18n.js", "lib.js", "sites.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content.css"],
      "matches": ["*://*.youtube.com/*", "*://youtu.be/*", "*://x.com/*", "*://www.x.com/*", "*://twitter.com/*", "*://www.twitter.com/*", "*://www.tiktok.com/*", "*://www.instagram.com/*"]
    }
  ]
}
