#!/bin/sh
# Fake ffmpeg: emits -progress lines; pass 2 writes FAKE_ENCODED_BYTES to the last argument.
# Record argv (one line per call) when FAKE_ARGV_LOG is set.
if [ -n "$FAKE_ARGV_LOG" ]; then
  { printf '%s' "$0"; for a in "$@"; do printf ' %s' "$a"; done; echo; } >> "$FAKE_ARGV_LOG"
fi
# Duration probe (`ffmpeg -i FILE`): FAKE_PROBE_OUTPUT replaces the line, else FAKE_DURATION seconds (default 10). Exits 1 like the real one.
if [ "$1" = "-hide_banner" ] && [ "$2" = "-i" ]; then
  d=${FAKE_DURATION:-10}
  echo "Input #0, mov,mp4, from '$3':"
  if [ -n "$FAKE_PROBE_OUTPUT" ]; then echo "$FAKE_PROBE_OUTPUT"; else printf '  Duration: %02d:%02d:%02d.00, start: 0.000000, bitrate: 800 kb/s\n' $((d/3600)) $((d%3600/60)) $((d%60)); fi
  echo "At least one output file must be specified"
  exit 1
fi
for a in "$@"; do
  [ "$a" = "-pass" ] && { echo "Error reading log file 'ffmpeg-pass-1.log' for pass-2 encoding (bare -pass; use -pass:v)" >&2; exit 1; }
  [ "$prev" = "-pass:v" ] && pass=$a
  prev=$a
  last=$a
done
[ "$FAKE_FFMPEG_MODE" = fail ] && exit 1
if [ "$FAKE_FFMPEG_MODE" = hang ]; then
  [ -n "$FAKE_FFMPEG_PID_FILE" ] && echo $$ > "$FAKE_FFMPEG_PID_FILE"
  exec sleep 30
fi
echo "out_time_us=5000000"
echo "progress=continue"
[ "$pass" = 2 ] && [ "$FAKE_FFMPEG_MODE" != nofile ] && head -c "${FAKE_ENCODED_BYTES:-1024}" /dev/zero > "$last"
echo "out_time_us=N/A"
echo "progress=end"
exit 0
