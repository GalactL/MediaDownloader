#!/bin/sh
# Fake yt-dlp for ContractTests. Behaviour via FAKE_YTDLP_MODE=ok|fail|hang (hang writes its pid to FAKE_YTDLP_PID_FILE),
# FAKE_SOURCE_BYTES, FAKE_YTDLP_PROBE_JSON.
# Record argv (one line per call) when FAKE_ARGV_LOG is set.
if [ -n "$FAKE_ARGV_LOG" ]; then
  { printf '%s' "$0"; for a in "$@"; do printf ' %s' "$a"; done; echo; } >> "$FAKE_ARGV_LOG"
fi
mode=${FAKE_YTDLP_MODE:-ok}
if [ "$1" = "-U" ]; then
  [ "$mode" = fail ] && { echo "ERROR: [fake] unable to update"; exit 1; }
  echo "Latest version: 2099.01.01"
  echo "yt-dlp is up to date"
  exit 0
fi
out=
for a in "$@"; do
  [ "$prev" = "--output" ] && out=$a
  [ "$a" = "--dump-single-json" ] && probe=1
  prev=$a
done
if [ "$mode" = fail ]; then
  echo "ERROR: [fake] boom: unable to download"
  exit 1
fi
if [ "$mode" = hang ]; then
  [ -n "$FAKE_YTDLP_PID_FILE" ] && echo $$ > "$FAKE_YTDLP_PID_FILE"
  exec sleep 30
fi
if [ -n "$probe" ]; then
  if [ -n "$FAKE_YTDLP_PROBE_JSON" ]; then echo "$FAKE_YTDLP_PROBE_JSON"
  else echo '{"id":"abc","title":"Fake Title","duration":10}'; fi
  exit 0
fi
dir=${out%/*}
# Like yt-dlp, %% in the template is a literal % (pure sh: some tests leave only head on PATH).
rest=$dir; dir=
while :; do case $rest in *%%*) dir=$dir${rest%%\%\%*}%; rest=${rest#*\%\%};; *) break;; esac; done
dir=$dir$rest
file="$dir/Fake Title [abc].mp4"
# Same shapes as the --progress-template / --print templates passed by the engine (one stream, so 0-85 % overall).
echo "[info] abc: Downloading 1 format(s)"
echo "[download] Destination: $file"
echo "__MD_DL__:abc"
echo "__MD_PROGRESS__:downloading|0|1000|NA|NA|NA|18"
echo "__MD_PROGRESS__:downloading|500|1000|NA|NA|NA|18"
echo "__MD_PROGRESS__:finished|1000|1000|NA|NA|NA|18"
echo "__MD_POST__:started|Merger"
echo "__MD_POST__:finished|Merger"
head -c "${FAKE_SOURCE_BYTES:-2048}" /dev/zero > "$file"
echo "__MD_FILE__:$file"
exit 0
